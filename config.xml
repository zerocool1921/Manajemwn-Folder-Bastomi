<?xml version='1.0' encoding='utf-8'?>
<widget id="com.bastomi.manajemenfolder" version="1.0.0" xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0" xmlns:android="http://schemas.android.com/apk/res/android">
    <name>Manajemen Folder</name>
    <description>Aplikasi Manajemen File dan Folder oleh Bastomi</description>
    <author email="admin@bastomi.com">Bastomi</author>
    <content src="index.html" />
    
    <access origin="*" />
    <allow-intent href="http://*/*" />
    <allow-intent href="https://*/*" />

    <!-- Plugin resmi Apache Cordova -->
    <plugin name="cordova-plugin-file" spec="^8.1.3" />

    <!-- Plugin native buatan sendiri: folder picker asli Android (SAF) +
         tombol izin "Kelola semua file" otomatis. Bebas dipakai karena kita
         build sendiri lewat GitHub Actions, tidak terikat batasan free plan
         layanan build pihak ketiga manapun. -->
    <plugin name="cordova-plugin-folderpicker-native" spec="plugins/cordova-plugin-folderpicker-native" />

    <preference name="AndroidXEnabled" value="true" />
    <preference name="GradlePluginGoogleServicesEnabled" value="false" />

    <platform name="android">
        <preference name="android-minSdkVersion" value="22" />
        <preference name="android-targetSdkVersion" value="34" />
        <preference name="android-compileSdkVersion" value="34" />

        <!-- Izin akses penyimpanan langsung lewat manifest, tanpa plugin permission -->
        <config-file target="AndroidManifest.xml" parent="/manifest">
            <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
            <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29" />
            <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
        </config-file>
        <config-file target="AndroidManifest.xml" parent="/manifest/application">
            <application android:requestLegacyExternalStorage="true" />
        </config-file>

        <preference name="AndroidPersistentFileLocation" value="Compatibility" />
    </platform>
</widget>
